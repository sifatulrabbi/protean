# Runtime: required
SANDBOX_WORKSPACE_BASE=/absolute/path/to/sandbox-workspaces
SANDBOX_SERVICE_TOKENS=sandbox-client:sk_123h2321h32kjkdfp12u
SANDBOX_DEFAULT_IMAGE=protean-sandbox:alpha

# Runtime: optional (defaults shown)
PORT=8091
SANDBOX_CONTAINER_PREFIX=protean-sandbox
SANDBOX_CONTAINER_WORKDIR=/workspace
SANDBOX_CONTAINER_USER=1000:1000
SANDBOX_EXEC_DEFAULT_TIMEOUT_MS=30000
SANDBOX_EXEC_MAX_TIMEOUT_MS=300000
SANDBOX_EXEC_MAX_OUTPUT_BYTES=65536

# Tests: optional
# Used by `go test -tags=integration ./...` and `make test-integration`.
# If unset, integration tests skip.
SANDBOX_TEST_IMAGE=protean-sandbox:smoke
