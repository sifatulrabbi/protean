# Protean platform configuration. All keys are host-level (D11) — they never enter a sandbox.

# HTTP API
PROTEAN_API_PORT=8788

# Filesystem root; protean-organizations/ lives under this directory.
PROTEAN_DATA_DIR=./tmp/app-data

# LLM providers (D4): OpenRouter is the default provider, OpenAI the secondary.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Web tools (D19): WebSearch and WebFetch both use Tavily.
TAVILY_API_KEY=
