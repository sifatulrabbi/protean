# Protean platform configuration. All keys are host-level (D11) — they never enter a sandbox.

# HTTP API
PROTEAN_API_PORT=8788

# Filesystem root; protean-organizations/ lives under this directory.
PROTEAN_DATA_DIR=./tmp/app-data

# Entitlements engine (D13). Defaults shown; SQLite path defaults to <PROTEAN_DATA_DIR>/protean.db.
PROTEAN_ENTITLEMENTS_WATCH_INTERVAL=30s
PROTEAN_HOST_DISK_WATERMARK_PCT=80
PROTEAN_LLM_RESERVE_TOKENS=50000
PROTEAN_SQLITE_DB_PATH=

# Sandbox runtime (S2). Defaults shown. The image is built by `make sandbox-image`.
# The exec timeout may not exceed 10m; MAX_RUNNING follows the VM sizing (0.25 vCPU / 1 GiB each).
PROTEAN_SANDBOX_IMAGE=protean-sandbox:dev
PROTEAN_SANDBOX_EXEC_TIMEOUT=120s
PROTEAN_SANDBOX_IDLE_TIMEOUT=15m
PROTEAN_SANDBOX_REAP_INTERVAL=1m
PROTEAN_SANDBOX_MAX_RUNNING=4
PROTEAN_SANDBOX_OUTPUT_CAP_BYTES=262144

# LLM providers (D4): OpenRouter is the default provider, OpenAI the secondary.
# The key of the selected provider is what the harness uses; a missing key does
# not stop the boot, it only disables the agent.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Agent harness (S5). Defaults shown. The base URL defaults to the provider's
# own (https://openrouter.ai/api/v1 or https://api.openai.com/v1); set it only
# to point at something else. MAX_TURNS is the runaway guard on one agent run.
PROTEAN_LLM_PROVIDER=openrouter
PROTEAN_LLM_MODEL=xiaomi/mimo-v2.5-pro
PROTEAN_LLM_BASE_URL=
PROTEAN_HARNESS_MAX_TURNS=40

# Optional OpenRouter attribution headers (HTTP-Referer and X-Title).
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Web tools (D19): WebSearch and WebFetch both use Tavily.
TAVILY_API_KEY=
